{
  "name": "open-apps",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A Grove-powered directory of production open-source apps.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build && pagefind --site dist",
    "dev": "astro dev",
    "start": "astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "audit": "grove audit --runs 1",
    "seo:check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@grove-dev/astro": "1.0.0",
    "@grove-dev/cli": "1.0.0",
    "@grove-dev/core": "1.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.2.10",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "pagefind": "1.5.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "svgo@>=4.0.0 <4.1.0": "^4.1.0",
      "devalue@<5.9.2": "^5.9.2",
      "@opentelemetry/core@<2.8.0": ">=2.8.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-7pqw-9j4j-h8q3"
      ]
    }
  }
}
