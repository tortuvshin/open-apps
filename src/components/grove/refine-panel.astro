---
import type { IndexFilters } from '@grove-dev/core';
/**
 * RefinePanel — multi-select facet dropdowns.
 *
 * Renders the ordered `groups` view-model produced by
 * `getDirectoryIndexModel().facetGroups` — visibility, ORDER, display
 * label, and selection mode all come from `browse.facets` + the core
 * facet registry, never from this component. Option labels arrive
 * pre-resolved from the taxonomy YAML, so the server render and the
 * client script share one label source.
 *
 * The URL is the list page base with each facet as a repeated key.
 * Empty values are dropped, so the URL stays clean.
 *
 * Filters apply live. Each checkbox or radio change builds the new
 * URL and asks the page to adopt it, and the popover stays open.
 * There is no Apply step.
 */
import { SORT_OPTIONS } from '@grove-dev/core';
import FilterGroupMenu from './filter-group-menu.astro';

interface FacetValue {
  value: string;
  label?: string;
  count?: number;
}

interface FacetGroupModel {
  id: string;
  filterKey: 'stacks' | 'platforms' | 'categories' | 'tags' | 'licenses';
  label: string;
  single?: boolean;
  options: FacetValue[];
  initial: string[];
}

interface Props {
  /** Ordered filter groups (see `getDirectoryIndexModel`). */
  groups: FacetGroupModel[];
  /** Current URL filter state — used to preselect the sort. */
  initial: IndexFilters;
  pathPrefix?: string;
  class?: string;
  /**
   * Emit the default flex layout on the root. Pass `false` when the
   * caller owns the layout — e.g. `layout={false} class="contents"` to
   * promote the filter triggers into the parent's flex row. Without
   * this the root's own `flex` would win over any display utility in
   * `class`, since Tailwind emits `.contents` before `.flex`.
   */
  layout?: boolean;
  /** Hide the sort select (e.g. when the page renders its own). */
  hide?: Array<'sort'>;
}

const {
  groups: groupModels,
  initial,
  pathPrefix = '/',
  class: className = '',
  layout = true,
  hide = [],
} = Astro.props;

function triggerLabel(group: FacetGroupModel): string {
  if (group.initial.length === 0) return `${group.label}: Any`;
  if (group.initial.length === 1) {
    const selected = group.initial[0];
    const option = group.options.find((candidate) => candidate.value === selected);
    return `${group.label}: ${option?.label ?? selected}`;
  }
  return `${group.label}: ${group.initial.length} selected`;
}

const groups = groupModels.map((group) => ({
  ...group,
  active: group.initial.length > 0,
  popoverId: `filter-popover-${group.filterKey}`,
  trigger: triggerLabel(group),
}));
---

<div
  class:list={[layout && "flex flex-wrap items-center gap-2", className]}
  role="toolbar"
  aria-label="Filter items"
  data-refine-panel
  data-path-prefix={pathPrefix}
>
    {groups.map((group) => <FilterGroupMenu {...group} />)}

    {!hide.includes("sort") && (
      <label class="relative">
        <span class="sr-only">Sort items</span>
        <select name="sort" class="h-9 cursor-pointer appearance-none border py-1.5 pl-3 pr-8 text-[0.8125rem] font-medium">
          {SORT_OPTIONS.map((option) => <option value={option.value} selected={(initial.sort ?? "recently-updated") === option.value}>{option.label}</option>)}
        </select>
        <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-400" fill="currentColor">
          <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"/>
        </svg>
      </label>
    )}
</div>

<script>
  import { DIRECTORY_FILTER_KEYS, isDirectoryFilterGroupKey } from "@grove-dev/core/directory";
  import { hrefForGroupSelection } from "../../lib/live-filters.ts";

  document.querySelectorAll<HTMLElement>("[data-refine-panel]").forEach((panel) => {
    const pathPrefix = panel.dataset.pathPrefix || "/";
    const groups = [...panel.querySelectorAll<HTMLElement>(".grove-filter")];
    const parts = (group: HTMLElement) => ({
      trigger: group.querySelector<HTMLButtonElement>(".grove-filter-trigger"),
      popover: group.querySelector<HTMLElement>(".grove-filter-popover"),
    });
    const isOpen = (group: HTMLElement) =>
      parts(group).trigger?.getAttribute("aria-expanded") === "true";

    // Tell the page when a popover opens or closes. DirectoryIndexClient
    // uses this to replace history entries while a popover is open and
    // push one entry when it closes.
    function setOpen(group: HTMLElement, open: boolean) {
      const { trigger, popover } = parts(group);
      if (!trigger || !popover || isOpen(group) === open) return;
      popover.hidden = !open;
      popover.classList.toggle("hidden", !open);
      trigger.setAttribute("aria-expanded", String(open));
      document.dispatchEvent(
        new CustomEvent("grove:filter-surface", {
          detail: { surface: `popover:${group.dataset.filterGroupKey}`, open },
        }),
      );
    }
    function closeAll(except?: HTMLElement) {
      for (const group of groups) if (group !== except) setOpen(group, false);
    }

    // A directory controller (DirectoryIndexClient) can adopt the URL
    // in place and re-render without a reload. It signals that by
    // cancelling the event. Anywhere else (a taxonomy page, or no
    // controller on the page) this falls back to navigating, so the
    // panel still works on its own.
    function go(url: string) {
      const event = new CustomEvent("grove:navigate", { detail: { url }, cancelable: true });
      if (document.dispatchEvent(event)) location.assign(url);
    }
    function navigate(group: HTMLElement, values: string[]) {
      const groupKey = group.dataset.filterGroupKey ?? "";
      if (!isDirectoryFilterGroupKey(groupKey)) return;
      go(hrefForGroupSelection(location.search, pathPrefix, DIRECTORY_FILTER_KEYS[groupKey], values));
    }
    const checkedValues = (group: HTMLElement) =>
      [...group.querySelectorAll<HTMLInputElement>(".grove-filter-input:checked")].map(
        (input) => input.dataset.filterValue ?? "",
      );

    for (const group of groups) {
      const { trigger, popover } = parts(group);
      trigger?.addEventListener("click", (event) => {
        event.stopPropagation();
        const opening = !isOpen(group);
        closeAll(opening ? group : undefined);
        setOpen(group, opening);
      });
      // Live: every change applies at once and the popover stays open,
      // so the next choice is one click away and the results behind it
      // show what the last one did.
      group.querySelectorAll<HTMLInputElement>(".grove-filter-input").forEach((input) => {
        input.addEventListener("change", () => navigate(group, checkedValues(group)));
      });
      group.querySelector(".grove-filter-clear")?.addEventListener("click", () => {
        navigate(group, []);
        // The Clear button hides once its group is empty. Keep keyboard
        // focus in the popover rather than letting it drop to <body>.
        group.querySelector<HTMLInputElement>(".grove-filter-input:not(:disabled)")?.focus();
      });
      popover?.addEventListener("click", (event) => event.stopPropagation());
    }
    document.addEventListener("click", () => closeAll());
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openGroup = groups.find(isOpen);
      if (!openGroup) return;
      // Escape closes the popover only. Inside the mobile drawer it
      // must not also close the drawer, so the default is cancelled.
      event.preventDefault();
      closeAll();
      // Put focus back on the trigger so keyboard users keep their place.
      parts(openGroup).trigger?.focus();
    });
    document.querySelector<HTMLSelectElement>('select[name="sort"]')?.addEventListener("change", (event) => {
      const params = new URLSearchParams(location.search);
      params.set("sort", (event.target as HTMLSelectElement).value);
      params.delete("page");
      go(params.toString() ? `${pathPrefix}?${params}` : pathPrefix);
    });
  });
</script>
