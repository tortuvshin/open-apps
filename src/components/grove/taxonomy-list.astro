---
import {
  buildProjectCardModel,
  indexSlug,
  itemLabel,
  itemLabelPlural,
} from '@grove-dev/astro/server';
import type { IndexRecord } from '@grove-dev/core';
import { formatCount } from '@grove-dev/core';
import EmptyState from '../ui/empty-state.astro';
/**
 * TaxonomyList.astro
 *
 * Shared body for the three taxonomy pages — `stacks/[name].astro`,
 * `categories/[name].astro`, `licenses/[name].astro`. The pages
 * differ only in the heading copy and the filterRecords field;
 * everything below the heading — the count, the card grid, the
 * empty state, the back link — is identical, so it lives here.
 *
 * Records render through the package's canonical `ProjectCard` inside
 * `CardGrid`, so taxonomy pages read as the same site as the browse
 * and collection pages.
 */
import CardGrid from './card-grid.astro';
import ProjectCard from './project-card.astro';

type TaxonomyRecord = IndexRecord;

interface Props {
  /** Eyebrow label above the heading ("Stack", "Category", "License"). */
  eyebrow: string;
  /** Display name shown in the heading and intro copy. */
  displayName: string;
  /** Lede copy under the heading. */
  lede: string;
  /**
   * Noun pair for the heading and count label. Defaults to the
   * blueprint's singular/plural labels so irregular plurals render
   * correctly on every blueprint.
   */
  itemNoun?: { singular: string; plural: string };
  /** Records filtered by `filterRecords` upstream. */
  records: TaxonomyRecord[];
  /**
   * Index route for the back link and card hrefs. Defaults to the
   * configured directory route (`routes.directory` in `grove.config.ts`),
   * so a site that browses at `/apps` links to `/apps`, not `/projects`.
   */
  backHref?: string;
  /** Back-link label. */
  backLabel?: string;
}

const {
  eyebrow,
  displayName,
  lede,
  itemNoun = { singular: itemLabel(), plural: itemLabelPlural() },
  records,
  backHref = `/${indexSlug()}`,
  backLabel = `← Back to all ${itemLabelPlural()}`,
} = Astro.props;

const count = records.length;
const hrefPrefix = backHref.replace(/\/$/, '');
---

<section class="mx-auto w-full max-w-container px-5 py-12 sm:px-7 sm:py-16">
  <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">{eyebrow}</p>
  <h1 class="m-0 mt-2 text-[1.875rem] font-semibold tracking-tight text-ink-900 sm:text-[2.125rem] dark:text-ink-100">
    {displayName} {itemNoun.plural}
  </h1>
  <p class="m-0 mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-500 dark:text-ink-400">{lede}</p>

  <div class="mt-10">
    <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
      {formatCount(count, itemNoun)}
    </p>

    {count === 0 ? (
      <EmptyState class="mt-4" title={`No ${itemNoun.plural} yet in ${displayName}.`} />
    ) : (
      <CardGrid class="mt-6">
        {records.map((record, i) => (
          <li class="m-0 p-0">
            <ProjectCard
              model={buildProjectCardModel(record)}
              href={`${hrefPrefix}/${record.slug}`}
              eager={i < 3}
            />
          </li>
        ))}
      </CardGrid>
    )}
  </div>

  <p class="mt-12 text-2xs text-ink-500 dark:text-ink-400">
    <a href={backHref} class="text-inherit no-underline hover:underline">
      {backLabel}
    </a>
  </p>
</section>
