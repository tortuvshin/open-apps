---
import { indexSlug, itemLabel, itemLabelPlural } from '@grove-dev/astro/server';
import { formatCount } from '@grove-dev/core';
import type { DirectoryScope } from '../../lib/live-filters.ts';
import EmptyState from '../ui/empty-state.astro';
/**
 * TaxonomyList.astro
 *
 * Shared body for the three taxonomy pages — `stacks/[name].astro`,
 * `categories/[name].astro`, `licenses/[name].astro`. The pages
 * differ only in the heading copy and the scope; everything else — the
 * hero, the list, the empty state, the back link — lives here.
 *
 * The list is the browse engine (`DirectoryBrowseView`) with an
 * immutable `scope`, so a stack or category page has the same search,
 * facets, sort and chips as the directory. Those live in this page's
 * own query string (`/stacks/flutter/?platform=ios`); the scoped group
 * is never a facet, a chip or a parameter. The canonical URL stays the
 * bare page path, because `Seo` builds it from the pathname.
 */
import DirectoryBrowseView from './directory-browse-view.astro';

interface Props {
  /** Eyebrow label above the heading ("Stack", "Category", "License"). */
  eyebrow: string;
  /** Display name shown in the heading and intro copy. */
  displayName: string;
  /** Full H1 override. Default: "{displayName} {itemNoun.plural}". */
  heading?: string;
  /** Lede copy under the heading. */
  lede: string;
  /**
   * Noun pair for the heading and count label. Defaults to the
   * blueprint's singular/plural labels so irregular plurals render
   * correctly on every blueprint.
   */
  itemNoun?: { singular: string; plural: string };
  /**
   * The slice of the directory this page lists, e.g.
   * `{ stacks: ['flutter'] }`. Merged into every query.
   */
  scope: DirectoryScope;
  /** How many records the scope holds (from the page model). */
  count: number;
  /**
   * This page's own path, without a trailing slash, e.g.
   * `/stacks/flutter`. Filtered URLs are built on it.
   */
  pathPrefix: string;
  /**
   * Index route for the back link. Defaults to the configured directory
   * route (`routes.directory` in `grove.config.ts`), so a site that
   * browses at `/apps` links to `/apps`, not `/projects`.
   */
  backHref?: string;
  /** Back-link label. */
  backLabel?: string;
}

const {
  eyebrow,
  displayName,
  heading,
  lede,
  itemNoun = { singular: itemLabel(), plural: itemLabelPlural() },
  scope,
  count,
  pathPrefix,
  backHref = `/${indexSlug()}/`,
  backLabel = `← Back to all ${itemLabelPlural()}`,
} = Astro.props;
---

<section class="bg-background">
  <div class="mx-auto w-full max-w-container px-5 pt-12 pb-8 sm:px-7 sm:pt-16">
    <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">{eyebrow}</p>
    <h1 class="m-0 mt-2 text-[1.875rem] font-semibold tracking-tight text-ink-900 sm:text-[2.125rem] dark:text-ink-100">
      {heading ?? `${displayName} ${itemNoun.plural}`}
    </h1>
    <p class="m-0 mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-500 dark:text-ink-400">{lede}</p>
  </div>
</section>

{/* The cards repeat every listed record; indexing them would make this
    page match each record's own search. The term is found by name. */}
<div data-pagefind-ignore>
  {count === 0 ? (
    <section class="mx-auto w-full max-w-container px-5 sm:px-7">
      <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
        {formatCount(count, itemNoun)}
      </p>
      <EmptyState class="mt-4" title={`No ${itemNoun.plural} yet in ${displayName}.`} />
    </section>
  ) : (
    <DirectoryBrowseView scope={scope} pathPrefix={pathPrefix} />
  )}
</div>

<section class="mx-auto w-full max-w-container px-5 pb-12 sm:px-7 sm:pb-16">
  <p class="m-0 text-2xs text-ink-500 dark:text-ink-400">
    <a href={backHref} class="text-inherit no-underline hover:underline">
      {backLabel}
    </a>
  </p>
</section>
