---
/**
 * DirectoryBrowse — the browse page body, shared by the two routes
 * that render it: `/{slug}/` (page 1) and `/{slug}/page/{n}/`.
 *
 * Layout, top to bottom:
 *   - PageHeader (the only place the page names itself) and lens tabs
 *   - `DirectoryBrowseView`: search + sort, facet filters, applied
 *     chips, the result count line, the card grid and pagination
 *   - The submit call to action
 *
 * Navigation model: **pages are real paths.** Each route prerenders
 * only its own 20 records, so an unfiltered directory of any size is
 * crawlable, works without JavaScript, and never ships the whole
 * catalogue as DOM.
 *
 * Filtering stays client-side: these routes are PRERENDERED, so at
 * build time `Astro.url.searchParams` is empty. `DirectoryIndexClient`
 * (rendered by `DirectoryBrowseView`) re-reads `location.search` and
 * re-derives the result list, chips, pagination, and facet
 * intersection counts with the same `@grove-dev/core/directory`
 * functions the server used. Filtered views paginate with `?page=N` on
 * the base route. Taxonomy pages render the same view with a `scope`.
 */
import siteConfig from '@grove/generated/site-config.json';
import {
  getDirectoryIndexModel,
  itemLabel,
  itemLabelPlural,
  seoTitle,
  titleCaseFirst,
} from '@grove-dev/astro/server';
import { formatCount } from '@grove-dev/core';
import BaseLayout from '../../layouts/base-layout.astro';
import Button from '../ui/button.astro';
import PageHeader from '../ui/page-header.astro';
import DirectoryBrowseView from './directory-browse-view.astro';
import SmartLensTabs from './smart-lens-tabs.astro';

interface Props {
  /** 1-based page this route renders. */
  routePage?: number;
}

const { routePage = 1 } = Astro.props;
const slug = siteConfig.blueprintConfig?.routeSlug ?? 'projects';
const { total, page, seo } = getDirectoryIndexModel(Astro.url.searchParams, siteConfig, {
  page: routePage,
});

// Page 2+ gets a distinct title and skips the ItemList JSON-LD so the
// list markup isn't duplicated across every paginated route. The
// per-page description is built inside `getDirectoryIndexModel` so it
// fits inside the 160-char cap; this view just forwards `seo.title`.
const title =
  page > 1
    ? seoTitle(`Browse ${titleCaseFirst(itemLabelPlural())} — Page ${page}`, siteConfig.name)
    : seo.title;
const description = seo.description;
---

<BaseLayout
  title={title}
  description={description}
  image={seo.image}
  jsonLd={page > 1 ? undefined : seo.jsonLd}
  site={siteConfig}
  submitHref="/submit"
  submitLabel={`Submit ${itemLabel()}`}
>
  <DirectoryBrowseView routePage={routePage}>
    <Fragment slot="header">
      <PageHeader
        eyebrow={slug}
        title={`Browse ${slug}`}
        description={`Search, filter, and explore ${formatCount(total, { singular: itemLabel(), plural: itemLabelPlural() })} in this directory.`}
      />

      {/* Curated views. Real links (not a JS-driven control) — the
          same server-and-client filter pipeline (@grove-dev/core's
          filtersFromSearchParams/filterRecords) already understands
          `?lens=`, so this works with JS disabled too. */}
      <SmartLensTabs
        currentParams={Astro.url.searchParams}
        pathPrefix={`/${slug}`}
        lensIds={["all", "hot", "new", "mature"]}
        class="mt-6"
      />
    </Fragment>
  </DirectoryBrowseView>

  <section class="border-t border-ink-200 dark:border-ink-800">
    <div class="mx-auto w-full max-w-container px-5 sm:px-7">
      <div class="flex flex-col items-center gap-3 py-12 text-center">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          {`Know a real ${itemLabel()} that belongs here?`}
        </h2>
        <p class="m-0 max-w-2xl text-sm text-ink-500 dark:text-ink-400">
          {`Open a pull request with a YAML file. We review every submission against the bar — no marketing, no tutorials.`}
        </p>
        <Button href="/submit" variant="primary" size="sm" class="mt-2">
          {`Submit ${itemLabel()}`}
        </Button>

      </div>
    </div>
  </section>
</BaseLayout>
