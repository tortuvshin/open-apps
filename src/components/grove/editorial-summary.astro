---
/**
 * EditorialSummary.astro
 *
 * The curator's notes that the header does not already show, as
 * ordinary article sections under their own headings.
 *
 * The header carries one verdict (`whyListed[0]`) and one caveat
 * (`caveats[0]`). A record with a written article covers the rest in
 * its own prose, so the detail page renders this component only for
 * records without one — the notes would otherwise appear twice.
 *
 * Renders nothing when there is nothing left to say.
 */
interface Props {
  /** `whyListed` minus the item the header shows. */
  whyListed: string[];
  bestFor: string[];
  /** `caveats` minus the item the header shows. */
  caveats: string[];
}

const { whyListed, bestFor, caveats } = Astro.props;
const sections = [
  { id: 'why-its-listed', title: "Why it's listed", items: whyListed },
  { id: 'best-for', title: 'Best for', items: bestFor },
  { id: 'consider-before-using', title: 'Consider before using', items: caveats },
].filter((section) => section.items.length > 0);
---

{sections.length > 0 && (
  <div class="grove-prose">
    {sections.map((section) => (
      <>
        <h2 id={section.id}>{section.title}</h2>
        <ul>
          {section.items.map((item) => <li>{item}</li>)}
        </ul>
      </>
    ))}
  </div>
)}
