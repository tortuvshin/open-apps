---
/**
 * CollectionGuide — the /collections/ index.
 *
 * Opens on the reader's question, explains the two kinds of collection
 * in plain words, features one editor's-picks story, and groups the
 * rest as small tiles by intent. Every line on a tile comes from the
 * collection file or its resolved entries; see `lib/collection-guide.ts`.
 */
import Container from '../../layouts/container.astro';
import { buttonClass } from '../../lib/classnames';

export interface GuideTile {
  slug: string;
  url: string;
  title: string;
  question: string;
  takeaway?: string;
  editorial: boolean;
  countLabel: string;
  examples: Array<{ title: string; url: string; pick?: string }>;
  dateLabel?: 'Reviewed' | 'Refreshed';
  date?: string;
  dateText?: string;
  introduction?: string;
  hasComparison: boolean;
}

interface Props {
  featured?: GuideTile;
  groups: Array<{ id: string; title: string; blurb: string; tiles: GuideTile[] }>;
}

const { featured, groups } = Astro.props;
const kindLabel = (t: GuideTile) => (t.editorial ? "Editor's picks" : 'Live view');
---

<section class="pt-10 pb-6 sm:pt-14 sm:pb-8">
  <Container>
    <span class="text-2xs font-medium uppercase tracking-wider text-muted-foreground">Collections</span>
    <h1 class="m-0 mt-2 text-[1.875rem] font-semibold leading-tight tracking-tight text-foreground sm:text-[2.375rem]">
      What are you looking for?
    </h1>
    <p class="m-0 mt-3 max-w-[64ch] text-[0.9375rem] leading-relaxed text-muted-foreground">
      Collections come in two kinds.{' '}
      <strong class="font-semibold text-foreground">Editor's picks</strong> are short lists where a
      person chose each app and wrote down why, with a review date.{' '}
      <strong class="font-semibold text-foreground">Live views</strong> are saved searches over the
      directory: the rules stay fixed and the list re-sorts whenever GitHub data syncs.
    </p>
  </Container>
</section>

{featured && (
  <section aria-labelledby="featured-heading" class="pb-10 sm:pb-12">
    <Container>
      <article class="grid gap-6 rounded-[var(--radius-lg)] border border-border bg-card p-5 sm:p-7 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-10">
        <div class="min-w-0">
          <p class="m-0 text-2xs font-medium uppercase tracking-wider text-muted-foreground">
            Featured · {kindLabel(featured)}
          </p>
          <h2 id="featured-heading" class="m-0 mt-2 text-[1.5rem] font-semibold leading-snug tracking-tight text-foreground sm:text-[1.75rem]">
            {featured.question}
          </h2>
          <p class="m-0 mt-1 text-sm font-medium text-muted-foreground">{featured.title}</p>
          {(featured.introduction ?? featured.takeaway) && (
            <p class="m-0 mt-4 max-w-[60ch] text-[0.9375rem] leading-relaxed text-foreground">
              {featured.introduction ?? featured.takeaway}
            </p>
          )}
          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
            <a href={featured.url} class={buttonClass('primary', 'md')} data-event="collection_card_click" data-event-source="collection_featured" data-event-item={featured.slug}>
              {featured.hasComparison ? 'Read the comparison' : 'See the picks'} →
            </a>
            <span class="text-2xs text-muted-foreground">
              {featured.countLabel}
              {featured.dateText && (
                <> · {featured.dateLabel} <time datetime={featured.date}>{featured.dateText}</time></>
              )}
            </span>
          </div>
        </div>
        {featured.examples.length > 0 && (
          <div class="min-w-0">
            <h3 class="m-0 text-2xs font-medium uppercase tracking-wider text-muted-foreground">Quick picks</h3>
            <ol class="m-0 mt-3 flex list-none flex-col gap-3 p-0">
              {featured.examples.map((ex) => (
                <li class="m-0 border-t border-border pt-3 first:border-t-0 first:pt-0">
                  <a href={ex.url} class="text-[0.9375rem] font-semibold text-foreground no-underline hover:underline">
                    {ex.title}
                  </a>
                  {ex.pick && <p class="m-0 mt-0.5 text-sm leading-relaxed text-muted-foreground">{ex.pick}</p>}
                </li>
              ))}
            </ol>
          </div>
        )}
      </article>
    </Container>
  </section>
)}

{groups.map((group) => (
  <section aria-labelledby={`group-${group.id}`} class="pb-8 sm:pb-10">
    <Container>
      <div class="grid gap-4 border-t border-border pt-6 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-8">
      <header class="flex flex-col gap-1">
        <h2 id={`group-${group.id}`} class="m-0 text-[1.25rem] font-semibold tracking-tight text-foreground">
          {group.title}
        </h2>
        {group.blurb && <p class="m-0 text-sm text-muted-foreground">{group.blurb}</p>}
      </header>
      <ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2">
        {group.tiles.map((tile) => (
          <li class="m-0 p-0">
            <a
              href={tile.url}
              data-event="collection_card_click"
              data-event-source="collection_index"
              data-event-item={tile.slug}
              class="group flex h-full min-w-0 flex-col gap-2 rounded-[var(--radius-lg)] border border-border bg-card p-4 no-underline outline-none transition-colors hover:border-ink-300 hover:bg-ink-50 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/35 sm:p-5 dark:hover:border-ink-700 dark:hover:bg-ink-900"
            >
              <span class="text-2xs font-medium uppercase tracking-wider text-muted-foreground">
                {kindLabel(tile)}
              </span>
              <h3 class="m-0 text-[1.0625rem] font-semibold leading-snug tracking-tight text-foreground group-hover:underline">
                {tile.question}
              </h3>
              <span class="text-sm font-medium text-foreground">{tile.title}</span>
              {tile.takeaway && (
                <p class="m-0 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{tile.takeaway}</p>
              )}
              {tile.examples.length > 0 && (
                <p class="m-0 text-sm text-foreground">
                  <span class="text-muted-foreground">Includes </span>
                  {tile.examples.map((ex) => ex.title).join(', ')}
                </p>
              )}
              <span class="mt-auto pt-2 text-2xs text-muted-foreground">
                {tile.countLabel}
                {tile.dateText && (
                  <> · {tile.dateLabel} <time datetime={tile.date}>{tile.dateText}</time></>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    </Container>
  </section>
))}
