---
/**
 * CollectionGuide — the /collections/ index.
 *
 * A short header with the two kinds of collection as a legend, one
 * featured editor's-picks story with its picks, then every other
 * collection as a card, grouped by what the reader wants to do. Every
 * line on a card comes from the collection file or its resolved
 * entries; see `lib/collection-guide.ts`.
 */
import { formatStars } from '@grove-dev/core';
import Container from '../../layouts/container.astro';
import { buttonClass } from '../../lib/classnames';
import CollectionTile, { type CollectionTileData } from './collection-tile.astro';

export interface GuideTile extends CollectionTileData {
  examples: Array<{ title: string; url: string; pick?: string; avatarUrl?: string; stars?: number }>;
  introduction?: string;
  hasComparison: boolean;
}

interface Props {
  featured?: GuideTile;
  groups: Array<{ id: string; title: string; blurb: string; tiles: GuideTile[] }>;
  totals: { collections: number; apps: number };
}

const { featured, groups, totals } = Astro.props;
// One grid, in intent order; each card names its intent.
const tiles = groups.flatMap((group) => group.tiles.map((tile) => ({ ...tile, intent: group.title })));
---

<section class="border-b border-border pb-10 pt-12 sm:pb-12 sm:pt-16">
  <Container>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-[60ch]">
        <p class="m-0 text-2xs font-medium uppercase tracking-wider text-muted-foreground">
          {totals.collections} collections · {totals.apps} apps covered
        </p>
        <h1 class="m-0 mt-2 text-[2rem] font-semibold leading-tight tracking-tight text-foreground sm:text-[2.625rem]">
          Collections
        </h1>
        <p class="m-0 mt-3 text-[1.0625rem] leading-relaxed text-muted-foreground">
          Shortlists for a question you already have — what to use instead of a product,
          which codebases to learn from, what is moving right now.
        </p>
      </div>
      <dl class="m-0 grid gap-2 text-sm sm:grid-cols-2 lg:w-[30rem]">
        <div class="rounded-[var(--radius-lg)] border border-border bg-card p-3">
          <dt class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2 py-0.5 text-2xs font-semibold text-emerald-700 dark:text-emerald-300">Editor's picks</dt>
          <dd class="m-0 mt-2 text-2xs leading-relaxed text-muted-foreground">A person chose each app and wrote down why. Dated reviews.</dd>
        </div>
        <div class="rounded-[var(--radius-lg)] border border-border bg-card p-3">
          <dt class="inline-flex items-center gap-1.5 rounded-full bg-secondary px-2 py-0.5 text-2xs font-semibold text-secondary-foreground">
            <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>Live view
          </dt>
          <dd class="m-0 mt-2 text-2xs leading-relaxed text-muted-foreground">Fixed rules over the directory, re-ranked on every GitHub sync.</dd>
        </div>
      </dl>
    </div>
  </Container>
</section>

{featured && (
  <section aria-labelledby="featured-heading" class="pt-10 sm:pt-12">
    <Container>
      <article class="grid overflow-hidden rounded-[var(--radius-lg)] border border-border bg-card lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="flex min-w-0 flex-col p-6 sm:p-8">
          <p class="m-0 flex items-center gap-2 text-2xs font-medium uppercase tracking-wider text-muted-foreground">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2 py-0.5 font-semibold normal-case tracking-normal text-emerald-700 dark:text-emerald-300">Featured</span>
            {featured.editorial ? "Editor's picks" : 'Live view'}
          </p>
          <h2 id="featured-heading" class="m-0 mt-4 text-[1.625rem] font-semibold leading-tight tracking-tight text-foreground sm:text-[2rem]">
            <a href={featured.url} class="text-foreground no-underline hover:underline">{featured.title}</a>
          </h2>
          {featured.question && <p class="m-0 mt-1.5 text-[0.9375rem] font-medium text-muted-foreground">{featured.question}</p>}
          {(featured.introduction ?? featured.takeaway) && (
            <p class="m-0 mt-4 max-w-[58ch] text-[0.9375rem] leading-relaxed text-foreground">
              {featured.introduction ?? featured.takeaway}
            </p>
          )}
          <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-6">
            <a href={featured.url} class={buttonClass('primary', 'md')} data-event="collection_card_click" data-event-source="collection_featured" data-event-item={featured.slug}>
              {featured.hasComparison ? 'Read the comparison' : 'See the picks'} →
            </a>
            <span class="text-2xs text-muted-foreground">
              {featured.countLabel}
              {featured.dateText && (
                <> · {featured.dateLabel} <time datetime={featured.date}>{featured.dateText}</time></>
              )}
            </span>
          </div>
        </div>
        {featured.examples.length > 0 && (
          <div class="min-w-0 border-t border-border bg-surface-sunken p-4 sm:p-6 lg:border-l lg:border-t-0">
            <h3 class="m-0 px-2 text-2xs font-medium uppercase tracking-wider text-muted-foreground">Quick picks</h3>
            <ol class="m-0 mt-2 flex list-none flex-col p-0">
              {featured.examples.map((ex, i) => (
                <li class="m-0">
                  <a href={ex.url} class="group flex items-start gap-3 rounded-[var(--radius)] px-2 py-2.5 no-underline hover:bg-accent">
                    {ex.avatarUrl ? (
                      <img src={ex.avatarUrl} alt="" width="36" height="36" loading="lazy" decoding="async" class="h-9 w-9 shrink-0 rounded-lg border border-border bg-background object-cover" />
                    ) : (
                      <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-background text-xs font-semibold text-muted-foreground">{i + 1}</span>
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="flex items-baseline justify-between gap-3">
                        <span class="text-[0.9375rem] font-semibold text-foreground group-hover:underline">{ex.title}</span>
                        {typeof ex.stars === 'number' && ex.stars > 0 && (
                          <span class="shrink-0 text-2xs tabular-nums text-muted-foreground">★ {formatStars(ex.stars)}</span>
                        )}
                      </span>
                      {ex.pick && <span class="mt-0.5 block text-sm leading-snug text-muted-foreground">{ex.pick}</span>}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </article>
    </Container>
  </section>
)}

{tiles.length > 0 && (
  <section aria-labelledby="all-collections" class="pb-16 pt-12">
    <Container>
      <header class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 id="all-collections" class="m-0 text-[1.25rem] font-semibold tracking-tight text-foreground">
          {featured ? 'More collections' : 'All collections'}
        </h2>
        <p class="m-0 text-sm text-muted-foreground">Grouped by what you want to do.</p>
      </header>
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {tiles.map((tile) => (
          <li class="m-0 p-0"><CollectionTile tile={tile} /></li>
        ))}
      </ul>
    </Container>
  </section>
)}
