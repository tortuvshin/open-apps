---
/**
 * FeaturedBadge — "Featured on <site>" README badge for maintainers.
 *
 * The SVGs are generated into `public/badges/` by the Grove build
 * (light and dark). The snippets link back to the record with
 * `?ref=badge` so badge traffic shows up in analytics, and the HTML
 * variant swaps to the dark badge through <picture>, which GitHub
 * READMEs honour.
 */
interface Props {
  /** Absolute URL of the record page, without a query string. */
  pageUrl: string;
  /** Absolute site origin, e.g. https://example.dev */
  origin: string;
  /** Site name, for the alt text. */
  siteName: string;
  /** Record name, for the alt text. */
  name: string;
  /** The `ref` value outbound links carry, if any — mentioned in the copy. */
  outboundRef?: string | false;
}

const { pageUrl, origin, siteName, name, outboundRef } = Astro.props;
const href = `${pageUrl}?ref=badge`;
const light = `${origin}/badges/featured.svg`;
const dark = `${origin}/badges/featured-dark.svg`;
const alt = `${name} on ${siteName}`;
const markdown = `[![${alt}](${light})](${href})`;
const html = `<a href="${href}"><picture><source media="(prefers-color-scheme: dark)" srcset="${dark}"><img alt="${alt}" src="${light}" height="40"></picture></a>`;
---

<section
  class="grove-card rounded-[var(--radius-lg)] border border-ink-200 bg-card p-4 dark:border-ink-800"
  aria-labelledby="sidebar-badge-title"
>
  <h2 id="sidebar-badge-title" class="m-0 text-2xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">
    Maintainer? Add the badge
  </h2>
  <p class="m-0 mt-1.5 text-sm leading-relaxed text-ink-700 dark:text-ink-300">
    Show readers where to find this page.
    {outboundRef && <> Visits from here reach your site with <code class="text-2xs">ref={outboundRef}</code>.</>}
  </p>
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="/badges/featured-dark.svg" />
    <img src="/badges/featured.svg" alt="" height="40" loading="lazy" decoding="async" class="mt-3 block h-10 w-auto" />
  </picture>
  <div class="mt-3 flex flex-wrap gap-2" data-badge-copy>
    <button type="button" data-copy={markdown} class="cursor-pointer rounded-[var(--radius)] border border-border bg-secondary px-2.5 py-1 text-2xs font-medium text-secondary-foreground hover:bg-accent">
      Copy Markdown
    </button>
    <button type="button" data-copy={html} class="cursor-pointer rounded-[var(--radius)] border border-border bg-secondary px-2.5 py-1 text-2xs font-medium text-secondary-foreground hover:bg-accent">
      Copy HTML
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-badge-copy] [data-copy]').forEach((button) => {
    const label = button.textContent?.trim() ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = label), 1500);
    });
  });
</script>
