---
/**
 * FilterDrawer — mobile filter surface built on native `<dialog>`.
 *
 * `showModal()` gives focus trapping, Escape handling, and the
 * top-layer backdrop for free — no dependency, no hand-rolled trap.
 * On viewports ≥ md the trigger button hides and the slotted filter
 * controls render inline through the same slot used on desktop, so
 * there is exactly one copy of the filter markup.
 *
 * No-JS fallback: the slot content stays in normal flow (the dialog
 * only wraps it once the client script moves it), so filters remain
 * usable without JavaScript.
 *
 * Filters inside the sheet apply live, so the page behind it is
 * already showing the real results. The sticky footer button
 * ("Show 12 apps") closes the sheet and moves focus to
 * `resultsTarget`. It is a way back to the results, not an apply
 * step. The page's controller keeps its label current: it sets the
 * text on `[data-drawer-results]`, and sets `aria-busy="true"` while
 * the results are still loading.
 *
 * The sheet announces itself with a `grove:filter-surface` event on
 * the document when it opens and closes. The page uses this to group
 * the changes made in one sitting into a single history entry.
 */
import { buttonClass } from '../../lib/classnames.ts';

interface Props {
  /** Trigger button label. */
  label?: string;
  /** Count of active filters shown on the trigger. */
  activeCount?: number;
  /** URL that clears every filter — offered inside the sheet. */
  clearHref?: string;
  /** Footer button label before the page's controller updates it. */
  resultsLabel?: string;
  /**
   * Selector for the element that receives focus when the footer
   * button closes the sheet, usually the results heading. It needs
   * `tabindex="-1"` if it is not focusable on its own.
   */
  resultsTarget?: string;
  class?: string;
}

const { label = 'Filters', activeCount = 0, clearHref, class: className = '' } = Astro.props;
---

<div class={`grove-filter-drawer ${className}`} data-grove-filter-drawer data-results-target={Astro.props.resultsTarget}>
  <button
    type="button"
    data-drawer-open
    class={buttonClass("secondary", "md", "w-full md:hidden")}
    aria-haspopup="dialog"
  >
    {label}
    {/* Always in the DOM (hidden at zero) so the client script can
        update it from the live URL state on this prerendered page. */}
    <span
      data-drawer-count
      class:list={[
        "inline-flex min-w-5 items-center justify-center rounded-full bg-selected px-1.5 py-0.5 font-mono text-2xs leading-none text-selected-foreground",
        activeCount === 0 && "hidden",
      ]}
    >
      {activeCount}
    </span>
  </button>

  {/* On mobile the client script moves this content into the dialog;
      on ≥ md it stays inline. Not hidden by CSS — without JS the
      filters must remain visible in flow on every viewport. */}
  <div data-drawer-content class="md:contents">
    <slot />
  </div>

  <dialog
    data-drawer-dialog
    class="m-0 mt-auto max-h-[85dvh] w-full max-w-none rounded-t-[calc(var(--radius)+0.5rem)] border-0 bg-surface-overlay p-0 text-foreground backdrop:bg-black/40 open:flex open:flex-col md:hidden"
    aria-label={label}
  >
    <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3">
      <p class="m-0 text-sm font-semibold">{label}</p>
      <div class="flex items-center gap-2">
        {clearHref && (
          /* Clearing from inside the sheet is the only way out of a
             stack of filters on mobile — the chips row is behind it. */
          <a
            href={clearHref}
            data-drawer-clear
            class:list={[buttonClass("ghost", "sm"), activeCount === 0 && "hidden"]}
          >
            Clear all
          </a>
        )}
        <button type="button" data-drawer-close class={buttonClass("ghost", "sm")}>
          Close
        </button>
      </div>
    </div>
    <div data-drawer-body class="min-h-0 flex-1 overflow-y-auto p-4"></div>
    {/* Outside the scrolling body, so it stays pinned to the bottom of
        the sheet however long the filter list is. */}
    <div class="border-t border-border p-4">
      <button
        type="button"
        data-drawer-results
        class={buttonClass("primary", "md", "w-full aria-busy:opacity-70")}
      >
        {Astro.props.resultsLabel ?? "Show results"}
      </button>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-grove-filter-drawer]").forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>("[data-drawer-dialog]");
    const content = root.querySelector<HTMLElement>("[data-drawer-content]");
    const body = root.querySelector<HTMLElement>("[data-drawer-body]");
    const open = root.querySelector<HTMLButtonElement>("[data-drawer-open]");
    const close = root.querySelector<HTMLButtonElement>("[data-drawer-close]");
    if (!dialog || !content || !body || !open) return;

    const mobile = window.matchMedia("(max-width: 47.999rem)");
    const place = () => {
      // One copy of the filter markup, moved between the inline slot
      // (desktop) and the dialog body (mobile).
      if (mobile.matches) {
        body.append(...content.children);
        content.classList.add("hidden");
      } else {
        if (dialog.open) dialog.close();
        content.append(...body.children);
        content.classList.remove("hidden");
      }
    };
    place();
    mobile.addEventListener("change", place);

    const results = root.querySelector<HTMLButtonElement>("[data-drawer-results]");
    const surface = (isOpen: boolean) =>
      document.dispatchEvent(
        new CustomEvent("grove:filter-surface", { detail: { surface: "drawer", open: isOpen } }),
      );

    open.addEventListener("click", () => {
      dialog.showModal();
      surface(true);
    });
    // `close` fires however the sheet closes: a button, Escape, or the
    // backdrop.
    dialog.addEventListener("close", () => surface(false));
    close?.addEventListener("click", () => dialog.close());
    results?.addEventListener("click", () => {
      dialog.close();
      // Closing the sheet puts focus back on the Filters button. The
      // results are what the user asked for, so move focus there. The
      // browser scrolls the target into view as part of focusing it.
      const selector = root.dataset.resultsTarget;
      const target = selector ? document.querySelector<HTMLElement>(selector) : null;
      target?.focus();
    });
    dialog.addEventListener("click", (event) => {
      // Backdrop click closes: the dialog element itself is the
      // target only when the click lands outside the panel content.
      if (event.target === dialog) dialog.close();
    });
  });
</script>
