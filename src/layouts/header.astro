---
/**
 * Header — sticky brand + nav + theme toggle.
 *
 * Generic: takes a `site` prop with brand + nav. No `siteConfig`
 * import — consumers compose the props from their own config.
 *
 * Optional `submit` button renders a "Submit app" / "Submit project"
 * call-to-action on the right side of the nav. Set `submitHref` /
 * `submitLabel` to enable, leave them undefined for a clean header.
 *
 * Optional `repoUrl` adds a "View source" GitHub button. Set
 * `repoLabel` to change the visible text.
 */

import { compact } from '@grove-dev/core';
import ThemeToggle from '../components/site/theme-toggle.astro';
import { buttonClass } from '../lib/classnames.ts';
import { loadCollections } from '@grove-dev/astro/server';

interface NavLink {
  label: string;
  href: string;
  description?: string;
}

interface NavItem extends NavLink {
  children?: NavLink[];
  menu?: 'collections';
}

interface Site {
  name: string;
  tagline?: string;
  nav: NavItem[];
  description?: string;
  repoUrl?: string;
  url?: string;
  /** Logo path under `public/` (e.g. `/logo.svg`). */
  logo?: string;
  stats?: {
    /** Stars on this site's own source repository. */
    repositoryStars?: number;
  };
  blueprintConfig?: {
    routeSlug?: string;
  };
}

interface Props {
  site: Site;
  /** Submit button label, e.g. "Submit app". Omit to hide. */
  submitLabel?: string;
  /** Submit button href, e.g. "/submit". Omit to hide. */
  submitHref?: string;
  /** GitHub button label, e.g. "View source". */
  repoLabel?: string;
  /** Extra class for the outer header element. */
  class?: string;
}

const { site, submitLabel, submitHref, repoLabel = 'Star', class: className = '' } = Astro.props;
const directoryPath = `/${site.blueprintConfig?.routeSlug ?? 'items'}`;
const defaultNavItems = site.blueprintConfig
  ? [
      { label: 'Recently added', href: `${directoryPath}?sort=recently-added` },
      { label: 'Trending', href: `${directoryPath}?label=hot` },
      { label: 'Categories', href: '/categories' },
      { label: 'Stacks', href: '/stacks' },
      { label: 'About', href: '/about' },
    ]
  : [];
const navItems = site.nav?.length ? site.nav : defaultNavItems;
// Menus from grove.config.ts: `children`, or the collection files for
// `menu: "collections"` (same resolution as Grove's registry header).
const collections = navItems.some((item: NavItem) => item.menu === 'collections')
  ? await loadCollections(process.cwd())
  : [];
const menus = (navItems as NavItem[]).map((item) => {
  const items: NavLink[] =
    item.menu === 'collections'
      ? collections
          .map((c) => ({ label: c.title, href: `/collections/${c.slug}/`, description: c.description }))
          .sort((a, b) => a.label.localeCompare(b.label))
      : (item.children ?? []);
  return { ...item, items, footer: item.menu === 'collections' ? { label: 'All collections', href: item.href } : undefined };
});
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const isCurrent = (menu: (typeof menus)[number], path: string) =>
  [menu.href, ...menu.items.map((c) => c.href)]
    .map((href) => withSlash(href.split('?')[0] ?? ''))
    .some((href) => href !== '/' && withSlash(path).startsWith(href));
const pathname = Astro.url.pathname;
const stars = site.stats?.repositoryStars;
const starsLabel = typeof stars === 'number' ? compact(stars) : null;
---

<header
  class:list={[
    "border-border bg-background/85 sticky top-0 z-50 border-b backdrop-blur",
    className,
  ]}
>
  <div
    class="mx-auto flex w-full max-w-container items-center gap-3 px-5 py-3 sm:gap-6 sm:px-7"
  >
    <a
      href="/"
      class="inline-flex min-w-0 shrink items-center gap-2 text-[0.95rem] font-semibold tracking-tight text-ink-900 dark:text-ink-100"
    >
      {site.logo ? (
        <img
          src={site.logo}
          alt=""
          aria-hidden="true"
          width="18"
          height="18"
          class="inline-block h-[18px] w-[18px] shrink-0 object-contain"
        />
      ) : (
        /* No logo configured — a neutral mark is the honest default.
           Set `site.logo` in grove.config.ts to replace it. */
        <span
          aria-hidden="true"
          class="inline-block h-[18px] w-[18px] rounded bg-ink-900 dark:bg-ink-100"
        ></span>
      )}
      <span class="truncate">{site.name}</span>
    </a>

    <nav class="hidden flex-1 md:block" aria-label="Primary">
      <ul class="m-0 flex list-none items-center gap-1 p-0">
        {menus.map((menu) => {
          const current = isCurrent(menu, pathname);
          const itemClass = [
            "relative inline-flex h-8 cursor-pointer list-none items-center gap-1 rounded-[var(--radius)] px-2.5 text-[0.875rem] font-medium no-underline outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/35 [&::-webkit-details-marker]:hidden",
            current ? "text-foreground after:absolute after:inset-x-2.5 after:-bottom-[0.8125rem] after:h-0.5 after:rounded-full after:bg-foreground after:content-['']" : "text-muted-foreground",
          ].join(" ");
          return (
            <li class="relative">
              {menu.items?.length ? (
                <details class="group" data-nav-menu>
                  <summary class={itemClass} aria-current={current ? "page" : undefined}>
                    {menu.label}
                    <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 transition-transform group-open:rotate-180"><path d="m4 6 4 4 4-4"></path></svg>
                  </summary>
                  <div class:list={[
                    "absolute left-0 top-[calc(100%+0.625rem)] z-50 rounded-[var(--radius-lg)] border border-border bg-popover p-2 shadow-lg",
                    menu.items.length > 5 ? "w-[34rem]" : "w-80",
                  ]}>
                    <ul class:list={["m-0 grid list-none gap-0.5 p-0", menu.items.length > 5 && "grid-cols-2"]}>
                      {menu.items.map((item) => (
                        <li>
                          <a href={item.href} class="block rounded-[var(--radius)] px-3 py-2 no-underline outline-none hover:bg-accent focus-visible:bg-accent">
                            <span class="block text-sm font-medium text-foreground">{item.label}</span>
                            {item.description && <span class="mt-0.5 line-clamp-2 block text-2xs leading-snug text-muted-foreground">{item.description}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                    {menu.footer && (
                      <a href={menu.footer.href} class="mt-1 flex items-center justify-between rounded-[var(--radius)] border-t border-border px-3 pb-1 pt-2.5 text-sm font-medium text-foreground no-underline hover:underline">
                        {menu.footer.label}<span aria-hidden="true">→</span>
                      </a>
                    )}
                  </div>
                </details>
              ) : (
                <a href={menu.href} class={itemClass} aria-current={current ? "page" : undefined}>{menu.label}</a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {/* Quick-find trigger. A plain button so the header has its final
          size before any search code loads: Pagefind's modal, bundle and
          index are fetched on first open (src/lib/quick-find.ts). */}
      <button
        type="button"
        data-search-trigger
        data-directory={`${directoryPath}/`}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-keyshortcuts="Meta+K Control+K /"
        aria-label="Search apps, collections and categories"
        title="Search (⌘K or /)"
        class="inline-flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-[var(--radius)] border border-border bg-secondary p-0 text-sm text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/35 aria-busy:cursor-progress lg:w-52 lg:justify-start lg:px-2.5"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="shrink-0">
          <circle cx="7" cy="7" r="4.75"></circle>
          <path d="m10.5 10.5 3.5 3.5"></path>
        </svg>
        <span class="hidden lg:inline">Search</span>
        <kbd
          data-search-shortcut
          aria-hidden="true"
          class="ml-auto hidden w-14 justify-center rounded border border-border bg-background px-1 py-0.5 font-mono text-2xs leading-none text-muted-foreground lg:inline-flex"
        >⌘K</kbd>
      </button>

      <details class="group relative md:hidden" data-nav-menu>
        <summary class="inline-flex h-9 cursor-pointer list-none items-center justify-center gap-1.5 rounded-[var(--radius)] border border-border bg-secondary px-2.5 text-sm font-medium text-foreground hover:bg-accent focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/35 [&::-webkit-details-marker]:hidden">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"></path></svg>
          Menu
        </summary>
        <nav aria-label="Mobile primary" class="fixed inset-x-3 top-[3.75rem] z-50 max-h-[calc(100dvh-5rem)] overflow-y-auto rounded-[var(--radius-lg)] border border-border bg-popover p-3 shadow-lg">
          <ul class="m-0 flex list-none flex-col gap-3 p-0">
            {menus.map((menu) => (
              <li>
                <a href={menu.href} aria-current={isCurrent(menu, pathname) ? "page" : undefined} class="block rounded-md px-2 py-1.5 text-sm font-semibold text-foreground no-underline hover:bg-accent aria-[current=page]:bg-accent">{menu.label}</a>
                {menu.items?.length ? (
                  <ul class="m-0 mt-1 grid list-none grid-cols-2 gap-0.5 p-0">
                    {menu.items.map((item) => (
                      <li><a href={item.href} class="block truncate rounded-md px-2 py-1.5 text-sm text-muted-foreground no-underline hover:bg-accent hover:text-foreground">{item.label}</a></li>
                    ))}
                  </ul>
                ) : null}
              </li>
            ))}
            {submitHref && (
              <li class="border-t border-border pt-3">
                <a href={submitHref} class={buttonClass("primary", "md", "w-full justify-center")}>{submitLabel ?? "Submit"}</a>
              </li>
            )}
          </ul>
        </nav>
      </details>

      {submitHref && (
        <a
          href={submitHref}
          class={buttonClass("primary", "sm", "max-sm:!hidden")}
        >
          <svg
            viewBox="0 0 16 16"
            width="13"
            height="13"
            aria-hidden="true"
            fill="currentColor"
          >
            <path d="M7.75 2a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 7.75 2Z"></path>
          </svg>
          <span>{submitLabel ?? "Submit"}</span>
        </a>
      )}

      {site.repoUrl && (
        <a
          href={site.repoUrl}
          target="_blank"
          rel="noopener"
          aria-label={`${repoLabel} on GitHub${starsLabel ? ` — ${starsLabel} stars` : ""}`}
          title={`${repoLabel} on GitHub`}
          class={buttonClass("secondary", "bare", "h-8 overflow-hidden p-0 text-sm")}
        >
          <span class="flex items-center gap-1.5 px-2.5 py-1.5 text-ink-900 dark:text-ink-100">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.33c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"></path>
            </svg>
            <span class="hidden lg:inline">{repoLabel}</span>
          </span>
          {starsLabel && <span class="hidden items-center gap-1 border-s border-border bg-secondary px-2 py-1.5 text-secondary-foreground sm:flex">
            <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" fill="currentColor" class="text-warning">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
            </svg>
            <span class="font-mono">{starsLabel}</span>
          </span>}
        </a>
      )}

      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  // Nav menus are <details>: one open at a time, closed by Escape,
  // an outside click, or following a link inside the panel.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-menu]")];
  const closeAll = (except?: HTMLDetailsElement) =>
    menus.forEach((menu) => { if (menu !== except) menu.open = false; });
  menus.forEach((menu) => {
    menu.addEventListener("toggle", () => { if (menu.open) closeAll(menu); });
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) menu.open = false;
    });
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("[data-nav-menu]")) closeAll();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = menus.find((menu) => menu.open);
    if (!open) return;
    open.open = false;
    open.querySelector("summary")?.focus();
  });

  // Quick-find: the button, ⌘K / Ctrl+K from anywhere, and `/` when the
  // user is not typing. Everything else lives in a chunk that is only
  // imported on first open.
  const searchTrigger = document.querySelector<HTMLButtonElement>("[data-search-trigger]");
  if (searchTrigger) {
    const isMac = /mac|iphone|ipad/i.test(navigator.userAgent);
    if (!isMac) {
      const hint = searchTrigger.querySelector("[data-search-shortcut]");
      if (hint) hint.textContent = "Ctrl K";
      searchTrigger.title = "Search (Ctrl+K or /)";
    }
    const openSearch = () =>
      import("../lib/quick-find.ts")
        .then(({ openQuickFind }) => openQuickFind(searchTrigger))
        .catch(() => {
          // No index (e.g. `astro dev`) or offline: the directory's own
          // filter is the next best search.
          window.location.href = searchTrigger.dataset.directory ?? "/";
        });
    const isTyping = (target: EventTarget | null) =>
      target instanceof HTMLElement &&
      (target.isContentEditable || !!target.closest("input, textarea, select"));
    searchTrigger.addEventListener("click", openSearch);
    document.addEventListener("keydown", (e) => {
      if (e.defaultPrevented || e.isComposing || e.altKey || e.shiftKey) return;
      const modK = (isMac ? e.metaKey : e.ctrlKey) && e.key.toLowerCase() === "k";
      const slash = e.key === "/" && !e.metaKey && !e.ctrlKey && !isTyping(e.target);
      if (!modK && !slash) return;
      if (searchTrigger.getAttribute("aria-expanded") === "true") return;
      e.preventDefault();
      openSearch();
    });
  }

  // Smooth-scroll for in-page anchor links (Header nav + Hero CTA).
  // Works on any <a href="#…"> that points to an existing element on
  // the current page. External links (e.g. /about, /projects?…) are
  // skipped because they don't start with "#". Modifier-clicks
  // (Cmd/Ctrl/Shift/middle) let the browser handle the anchor
  // normally so users can open the same section in a new tab.
  document.addEventListener("click", (e) => {
    if (e.defaultPrevented) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    if (e.button !== 0) return;
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>(
      'a[href^="#"]',
    );
    if (!link) return;
    const id = link.getAttribute("href")!;
    if (id.length <= 1) return;
    const target = document.querySelector(id);
    if (!target) return;
    e.preventDefault();
    target.scrollIntoView({ behavior: "smooth", block: "start" });
    history.replaceState(null, "", id);
  });
</script>
