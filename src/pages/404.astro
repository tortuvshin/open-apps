---
/**
 * 404 — generic fallback page.
 *
 * Renders the normal shell (header / footer / theme toggle) with a
 * short message and a search form pointing at the list page. Stays
 * on-brand regardless of blueprint.
 */
import siteConfig from '@grove/generated/site-config.json';
import { indexSlug } from '@grove-dev/astro/server';
import SearchField from '../components/ui/search-field.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { buttonClass } from '../lib/classnames.ts';

const slug = indexSlug();
const title = `Not found — ${siteConfig.name}`;
const description = `That page doesn't exist on ${siteConfig.name}.`;
---

<BaseLayout
  title={title}
  description={description}
  site={siteConfig}
  noindex
>
  {/* One recovery hierarchy: search is the primary tool, Browse the
      single button action, home a quiet text link — no three
      competing primary CTAs. Centered so the wide viewport doesn't
      pin everything into the top-left corner. */}
  <section class="py-12 sm:py-16">
    <div class="mx-auto w-full max-w-narrow px-5 py-16 text-center sm:px-7 sm:py-24">
      <span class="text-2xs font-medium uppercase tracking-wider text-muted-foreground">
        404
      </span>
      <h1 class="m-0 mt-2 text-[2.25rem] font-semibold leading-[1.05] tracking-tight text-foreground sm:text-[3rem]">
        Page not found
      </h1>
      <p class="mx-auto m-0 mt-4 max-w-xl text-lg leading-relaxed text-muted-foreground">
        The page you're looking for doesn't exist on {siteConfig.name}.
        It may have been moved, renamed, or never existed.
      </p>

      <form
        class="mx-auto mt-8 flex max-w-xl flex-col gap-2 sm:flex-row sm:items-center"
        role="search"
        action={`/${slug}`}
        method="get"
      >
        <SearchField class="flex-1" label="Search" placeholder={`Search ${slug}...`} id="not-found-search" />
        <button type="submit" class={buttonClass("primary", "bare", "h-10 px-4 text-sm max-sm:min-h-11")}>
          Search
        </button>
      </form>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a href={`/${slug}`} class={buttonClass("secondary", "sm")}>Browse {slug}</a>
        <a href="/" class="text-sm font-medium text-muted-foreground underline decoration-border underline-offset-2 hover:text-foreground">
          Back to home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
