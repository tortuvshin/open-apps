---
/**
 * Detail page — thin consumer wiring up the package's
 * RecordHeader, EditorialSummary, TableOfContents, MarkdownBody,
 * and RecordSidebar components. All rendering logic, prose
 * styling, sidebar visibility, and activity-badge rules live in
 * `@grove-dev/astro`; this file only composes them.
 */
import records from '@grove/generated/records.json';
import siteConfig from '@grove/generated/site-config.json';
import {
  getRecordContextModel,
  getRecordDetailModel,
  loadCollections,
  recordDetailPaths,
  recordsToCollectionEntries,
} from '@grove-dev/astro/server';
import EditorialSummary from '../../components/grove/editorial-summary.astro';
import MarkdownBody from '../../components/grove/markdown-body.astro';
import RelatedRecords from '../../components/grove/related-records.astro';
import RecordHeader from '../../components/grove/record-header.astro';
import RecordRelations from '../../components/grove/record-relations.astro';
import RecordSidebar from '../../components/grove/record-sidebar.astro';
import TableOfContents from '../../components/grove/table-of-contents.astro';
import SearchMeta from '../../components/site/search-meta.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { recordTitle } from '../../lib/seo';

export function getStaticPaths() {
  return recordDetailPaths(siteConfig);
}

const dirSlug = siteConfig.blueprintConfig?.routeSlug ?? 'projects';
const detail = getRecordDetailModel(
  Astro.params.recordSlug ?? '',
  siteConfig,
  Astro.params.slug ?? dirSlug,
);
if (!detail) return Astro.redirect(`/${dirSlug}`);
const { record, name, itemSingular, seo } = detail;
// Stack and health only exist on project records.
const project = record.kind === 'project' ? record : undefined;

// Where this page links out to: subject hubs, sibling records, and the
// collections the record appears in.
const context = getRecordContextModel(record, {
  collections: await loadCollections(process.cwd()),
  entries: recordsToCollectionEntries(
    (records as { records: unknown[] }).records as never,
    siteConfig,
  ),
  subjects: siteConfig.taxonomy?.subjects ?? [],
});

// A record the health sweep has hidden is off every list and out of
// the sitemap; its page stays up for old links but is not indexed.
const hidden = project?.health?.visibility === 'hide';

// Search-intent title: the record's own `seo.title`, else a use-case
// phrase — never the package's "Open-source {Category} app".
const termName = (terms: { id: string; name: string }[] | undefined, id: string | undefined) =>
  terms?.find((term) => term.id === id)?.name;
const title = recordTitle(
  {
    name,
    summary: record.summary,
    seoTitle: record.seo?.title,
    categoryLabel: termName(siteConfig.taxonomy?.categories, record.category),
    stackLabel: termName(siteConfig.taxonomy?.stacks, project?.stack)?.replace(/\s*\(.*\)$/, ''),
    singular: itemSingular,
  },
  siteConfig.name,
);

// Quick-find row and hidden aliases: the search-intent title ("Oinkoin –
// Open Source Offline Expense Tracker"), what it is an alternative to,
// its stack and tags — words people type that the body may not contain.
const indexable = !(seo.noindex || hidden);
const taxonomy = siteConfig.taxonomy;
const alternativeTo = (record.relations ?? [])
  .filter((relation) => relation.type === 'alternative-to')
  .map((relation) => termName(taxonomy?.subjects, relation.to) ?? relation.to);
const searchMeta = {
  summary: detail.description,
  category: termName(taxonomy?.categories, record.category),
  platforms: detail.platforms.map((id) => termName(taxonomy?.platforms, id) ?? id).join(', '),
  aliases: [
    title.replace(` | ${siteConfig.name}`, ''),
    ...alternativeTo.map((subject) => `${subject} alternative`),
    termName(taxonomy?.stacks, project?.stack),
    ...detail.tags,
  ]
    .filter(Boolean)
    .join(', '),
};
---

<BaseLayout
  title={title}
  description={seo.description}
  image={seo.image}
  imageAlt={seo.imageAlt}
  site={siteConfig}
  noindex={seo.noindex || hidden}
  type="article"
  jsonLd={seo.jsonLd}
  submitHref="/submit"
  submitLabel={`Submit ${itemSingular}`}
>
  <article class="py-8 sm:py-10" data-pagefind-body={indexable ? "" : undefined}>
    {indexable && <SearchMeta type="App" meta={searchMeta} />}
    <div class="mx-auto w-full max-w-container px-5 sm:px-7">
      <RecordHeader detail={detail} />
      <RecordRelations relations={context.relations} />

      <div
        class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-12"
      >
        {/* Reading column: editorial context, then the article —
            no TOC panel pushing the body down. */}
        <div class="min-w-0">
          <EditorialSummary
            bestFor={detail.bestFor}
            caveats={detail.caveats}
            whyListed={detail.whyListed}
          />
          <MarkdownBody
            recordSlug={record.slug}
            fallback={record.content ? "This record doesn't have notes yet." : undefined}
          />
        </div>
        {/* Right rail: the TOC and nothing else. */}
        <div data-pagefind-ignore class="min-w-0 lg:sticky lg:top-20 lg:max-h-[calc(100vh-5rem)] lg:self-start lg:overflow-y-auto">
          <TableOfContents items={detail.toc} />
        </div>
      </div>

      {/* Other records' names would make this page match their searches. */}
      <div data-pagefind-ignore>
        <RelatedRecords context={context} />
      </div>

      {/* Metadata panels — full width below the article. */}
      <section data-pagefind-ignore class="mt-12 border-t border-border pt-8" aria-label="Project details">
        <RecordSidebar detail={detail} sticky={false} layout="grid" />
      </section>
    </div>
  </article>
</BaseLayout>
