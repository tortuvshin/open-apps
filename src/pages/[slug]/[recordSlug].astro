---
/**
 * Detail page — thin consumer wiring up the package's
 * RecordHeader, EditorialSummary, TableOfContents, MarkdownBody,
 * and RecordSidebar components. All rendering logic, prose
 * styling, sidebar visibility, and activity-badge rules live in
 * `@grove-dev/astro`; this file only composes them.
 */
import siteConfig from '@grove/generated/site-config.json';
import { getRecordDetailModel, recordDetailPaths } from '@grove-dev/astro/server';
import EditorialSummary from '../../components/grove/editorial-summary.astro';
import MarkdownBody from '../../components/grove/markdown-body.astro';
import RecordHeader from '../../components/grove/record-header.astro';
import RecordSidebar from '../../components/grove/record-sidebar.astro';
import TableOfContents from '../../components/grove/table-of-contents.astro';
import BaseLayout from '../../layouts/base-layout.astro';

export function getStaticPaths() {
  return recordDetailPaths(siteConfig);
}

const dirSlug = siteConfig.blueprintConfig?.routeSlug ?? 'projects';
const detail = getRecordDetailModel(
  Astro.params.recordSlug ?? '',
  siteConfig,
  Astro.params.slug ?? dirSlug,
);
if (!detail) return Astro.redirect(`/${dirSlug}`);
const { record, itemSingular, seo } = detail;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  imageAlt={seo.imageAlt}
  site={siteConfig}
  noindex={seo.noindex}
  type="article"
  jsonLd={seo.jsonLd}
  submitHref="/submit"
  submitLabel={`Submit ${itemSingular}`}
>
  <article class="py-8 sm:py-10">
    <div class="mx-auto w-full max-w-container px-5 sm:px-7">
      <RecordHeader detail={detail} />

      <div
        class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-12"
      >
        {/* Reading column: editorial context, then the article —
            no TOC panel pushing the body down. */}
        <div class="min-w-0">
          <EditorialSummary bestFor={detail.bestFor} caveats={detail.caveats} />
          <MarkdownBody
            recordSlug={record.slug}
            fallback={record.content ? "This record doesn't have notes yet." : undefined}
          />
        </div>
        {/* Right rail: the TOC and nothing else. */}
        <div class="min-w-0 lg:sticky lg:top-20 lg:max-h-[calc(100vh-5rem)] lg:self-start lg:overflow-y-auto">
          <TableOfContents items={detail.toc} />
        </div>
      </div>

      {/* Metadata panels — full width below the article. */}
      <section class="mt-12 border-t border-border pt-8" aria-label="Project details">
        <RecordSidebar detail={detail} sticky={false} layout="grid" />
      </section>
    </div>
  </article>
</BaseLayout>
