---
/**
 * List page — page 1 of the discovery / browse page.
 *
 * The body lives in `DirectoryBrowse` because two routes render it:
 * this one and `/{slug}/page/{n}/`. The URL slug (e.g. `/projects/`,
 * `/resources/`, `/entities/`) is derived from the blueprint, so the
 * same page works for every blueprint without per-blueprint forks.
 */
import siteConfig from '@grove/generated/site-config.json';
import DirectoryBrowse from '../../components/grove/directory-browse.astro';

export function getStaticPaths() {
  const routeSlug = siteConfig.blueprintConfig?.routeSlug ?? 'projects';
  return [{ params: { slug: routeSlug } }];
}
---

<DirectoryBrowse routePage={1} />
