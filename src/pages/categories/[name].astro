---
import siteConfig from '@grove/generated/site-config.json';
import { getTaxonomyPageModel, itemLabelPlural } from '@grove-dev/astro/server';
import TaxonomyList from '../../components/grove/taxonomy-list.astro';
import SearchMeta from '../../components/site/search-meta.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { taxonomyDescription, taxonomyHeading, taxonomyTitle, type TaxonomyTerm } from '../../lib/seo';

export function getStaticPaths() {
  const categories = siteConfig.taxonomy?.categories ?? [];
  // The whole term travels as a prop: `seoTitle` / `heading` /
  // `description` in `data/taxonomy/categories.yml` are editorial overrides.
  return categories.map((term) => ({
    params: { name: term.id },
    props: { displayName: term.name, term: term as TaxonomyTerm },
  }));
}

const { displayName, term } = Astro.props;
const name = Astro.params.name;
const model = getTaxonomyPageModel('categories', name, displayName, siteConfig);
const plural = itemLabelPlural();
// Empty terms are noindex; so is a term without intro copy (`description`
// in data/taxonomy) under the index policy — that one stays in quick-find.
const searchable = model.records.length > 0;
const indexable = searchable && !model.seo.noindex;
const description = taxonomyDescription('categories', term, plural);
---

<BaseLayout
  title={taxonomyTitle(term, plural, siteConfig.name)}
  description={description}
  image={model.seo.image}
  imageAlt={model.seo.imageAlt}
  jsonLd={model.seo.jsonLd}
  site={siteConfig}
  noindex={!indexable}
  robots={searchable ? model.seo.robots : undefined}
>
  <div data-pagefind-body={searchable ? "" : undefined}>
    {searchable && (
      <SearchMeta
        type="Category"
        title={displayName}
        meta={{
          summary: description,
          aliases: [taxonomyHeading(term, plural), term.seoTitle, name].filter(Boolean).join(', '),
        }}
      />
    )}
    <TaxonomyList
      eyebrow="Category"
      displayName={displayName}
      heading={taxonomyHeading(term, plural)}
      lede={description}
      scope={{ categories: [name] }}
      count={model.records.length}
      pathPrefix={`/categories/${name}`}
    />
  </div>
</BaseLayout>
