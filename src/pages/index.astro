---
/**
 * Home page.
 *
 * Structure: Hero → Trending now → StackGrid → CategoryGrid →
 * CollectionTeaser → Recently added → ContributorsGrid →
 * OriginalCollection → FinalCta.
 *
 * The order follows how people search: what's moving, then by stack,
 * then by what the app does, then the curated lists. "Trending now"
 * is the top of the `trending-open-source-apps` collection — same
 * query, same ranking — so the strip and its "view all" page can
 * never disagree. Neither lens comes from `getHomePageModel`, whose
 * hot / mature lenses are star-driven and largely echo each other.
 *
 * All data derives from `data/generated/records.{index,full}.json`
 * and `data/generated/site-config.json`. Nothing here is hardcoded
 * to a specific blueprint — section copy uses singular/plural
 * labels from `itemLabel()`/`itemLabelPlural()`.
 */
import BaseLayout from "../layouts/base-layout.astro";
import Hero from "../components/grove/hero.astro";
import HeroProof from "../components/grove/hero-proof.astro";
import RecordSection from "../components/grove/record-section.astro";
import StackGrid from "../components/grove/stack-grid.astro";
import CategoryGrid from "../components/grove/category-grid.astro";
import ContributorsGrid from "../components/grove/contributors-grid.astro";
import OriginalCollection from "../components/grove/original-collection.astro";
import FinalCta from "../components/grove/final-cta.astro";
import CollectionTeaser from "../components/grove/collection-teaser.astro";

import {
  getCollectionTeaserModel,
  getHomePageModel,
  loadCollections,
  recordsToCollectionEntries,
  seoTitle,
} from "@grove-dev/astro/server";
import { applySort, runCollection } from "@grove-dev/core";
import { HOME_TITLE } from "../lib/seo";
import type { IndexRecord } from "@grove-dev/core";
import records from "@grove/generated/records.json";
import indexPayload from "@grove/generated/records.index.json";
import siteConfig from "@grove/generated/site-config.json";

const home = getHomePageModel(siteConfig);
const { slug, itemSingular, itemPlural } = home;
const { seo } = home;

// ── Collections (teaser + the trending strip) ───────────────────
const allCollections = await loadCollections(process.cwd());
const entries = recordsToCollectionEntries(
  (records as { records: unknown[] }).records as never,
  siteConfig,
);
const collectionTeaser = getCollectionTeaserModel(allCollections, entries, 3);

// ── Lens sectioning (Trending / New) ────────────────────────────
const TRENDING_SLUG = "trending-open-source-apps";
const projects = ((indexPayload as { records: unknown[] }).records as IndexRecord[]).filter(
  (record) => record.kind === "project",
);
const projectBySlug = new Map<string, IndexRecord>(projects.map((record) => [record.slug, record]));
const trending = allCollections.find((collection) => collection.slug === TRENDING_SLUG);
// Without the collection file the strip falls back to last-push order
// rather than disappearing.
const trendingList: IndexRecord[] = trending
  ? runCollection(trending, entries)
      .entries.flatMap((entry) => projectBySlug.get(entry.slug) ?? [])
      .slice(0, 6)
  : applySort(projects, "recently-updated").slice(0, 6);
// Dedupe so a single record never renders as two cards on one page.
const trendingSlugs = new Set(trendingList.map((record) => record.slug));
const newList = applySort(
  projects.filter((record) => !trendingSlugs.has(record.slug)),
  "recently-added",
).slice(0, 6);

const { stacks, categories } = home;

const { contributors, stats } = home;
const Plural = itemPlural.charAt(0).toUpperCase() + itemPlural.slice(1);
---

<BaseLayout
  title={seoTitle(HOME_TITLE, siteConfig.name)}
  description={seo.description}
  image={seo.image}
  jsonLd={seo.jsonLd}
  site={siteConfig}
>
  <Hero
    name={`Discover real open-source ${itemPlural}`}
    tagline="and production codebases."
    description={`Browse ${itemPlural} you can run, study and contribute to — organized by stack, category, platform, activity and maturity.`}
    eyebrow={`A directory of real curated ${itemPlural}`}
    stats={{
      totalApps: stats.apps,
      totalCategories: stats.categories,
      totalStacks: stats.stacks,
      totalOwners: stats.owners,
      totalStars: stats.stars,
    }}
    itemsLabel={itemPlural}
    searchHref={`/${slug}`}
    searchPlaceholder={`Search ${itemPlural}, stacks, or categories...`}
    quickFilters={[
      { label: "Trending", href: `/collections/${TRENDING_SLUG}/` },
      { label: "Recently added", href: `/${slug}?sort=recently-added` },
      { label: "Most starred", href: `/${slug}?sort=most-starred` },
    ]}
    ctas={[
      { label: `Browse ${itemPlural}`, href: `/${slug}/`, variant: "primary" },
    ]}
  >
    {siteConfig.press.length > 0 && <HeroProof slot="eyebrow" variant="pill" />}
    <HeroProof slot="proof" variant="row" contributors={contributors} />
  </Hero>

  <RecordSection
    id="trending"
    title="Trending now"
    description={`${Plural} under the most active development right now — ranked by recent commits and releases, not by total stars.`}
    eyebrow="Trending"
    items={trendingList}
    limit={6}
    hrefFor={(r) => `/${slug}/${r.slug}/`}
    viewAllHref={`/collections/${TRENDING_SLUG}/`}
    viewAllLabel="View all trending"
  />

  <StackGrid
    stacks={stacks}
    pathPrefix={`/${slug}`}
    itemLabelPlural={itemPlural}
    itemNoun={{ singular: itemSingular, plural: itemPlural }}
    hrefFor={(stackSlug: string) => `/stacks/${stackSlug}/`}
  />
  <CategoryGrid
    categories={categories}
    pathPrefix={`/${slug}`}
    itemLabelPlural={itemPlural}
    itemNoun={{ singular: itemSingular, plural: itemPlural }}
    heading="Browse by what they do"
    hrefFor={(categorySlug: string) => `/categories/${categorySlug}/`}
  />
  <CollectionTeaser
    model={collectionTeaser}
    title="Curated collections"
    description="Lists with a stated rule — what qualifies, what is excluded, and how it is ranked."
    countNoun={{ singular: itemSingular, plural: itemPlural }}
  />

  <RecordSection
    id="new"
    title="Recently added"
    description={`${Plural} added to the directory in the last few weeks.`}
    eyebrow="New"
    items={newList}
    limit={6}
    hrefFor={(r) => `/${slug}/${r.slug}/`}
    viewAllHref={`/${slug}?sort=recently-added`}
    viewAllLabel={`View all recently added`}
  />

  <ContributorsGrid
    contributors={contributors}
    total={contributors.length || undefined}
    viewAllHref={`/contributors`}
    viewAllLabel="Meet the community"
    showContributionCount={siteConfig.contributors?.showContributionCount ?? true}
  />

  {siteConfig.stats?.originalRepo && (
    <OriginalCollection
      repoUrl={siteConfig.stats.originalRepo}
      stats={{
        stars: siteConfig.stats.originalStars,
        forks: siteConfig.stats.originalForks,
        contributors: siteConfig.stats.originalContributors,
      }}
    />
  )}

  <FinalCta
    itemLabel={itemSingular}
    itemsLabel={itemPlural}
    browseHref={`/${slug}`}
  />
</BaseLayout>
