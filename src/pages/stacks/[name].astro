---
import siteConfig from '@grove/generated/site-config.json';
import { getTaxonomyPageModel, itemLabelPlural } from '@grove-dev/astro/server';
import TaxonomyList from '../../components/grove/taxonomy-list.astro';
import SearchMeta from '../../components/site/search-meta.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { taxonomyDescription, taxonomyHeading, taxonomyTitle, type TaxonomyTerm } from '../../lib/seo';

export function getStaticPaths() {
  const stacks = siteConfig.taxonomy?.stacks ?? [];
  // The whole term travels as a prop: `seoTitle` / `heading` /
  // `description` in `data/taxonomy/stacks.yml` are editorial overrides.
  return stacks.map((term) => ({
    params: { name: term.id },
    props: { displayName: term.name, term: term as TaxonomyTerm },
  }));
}

const { displayName, term } = Astro.props;
const name = Astro.params.name;
const model = getTaxonomyPageModel('stacks', name, displayName, siteConfig);
const plural = itemLabelPlural();
const indexable = model.records.length > 0;
const description = taxonomyDescription('stacks', term, plural);
---

<BaseLayout
  title={taxonomyTitle(term, plural, siteConfig.name)}
  description={description}
  image={model.seo.image}
  imageAlt={model.seo.imageAlt}
  jsonLd={model.seo.jsonLd}
  site={siteConfig}
  noindex={!indexable}
>
  <div data-pagefind-body={indexable ? "" : undefined}>
    {indexable && (
      <SearchMeta
        type="Stack"
        title={displayName}
        meta={{
          summary: description,
          aliases: [taxonomyHeading(term, plural), term.seoTitle, name].filter(Boolean).join(', '),
        }}
      />
    )}
    <TaxonomyList
      eyebrow="Stack"
      displayName={displayName}
      heading={taxonomyHeading(term, plural)}
      lede={description}
      records={model.records}
    />
  </div>
</BaseLayout>
