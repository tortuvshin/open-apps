---
import records from '@grove/generated/records.json';
import siteConfig from '@grove/generated/site-config.json';
import {
  getCollectionBodyHtml,
  getCollectionPageModel,
  loadCollections,
  recordsToCollectionEntries,
} from '@grove-dev/astro/server';
import CollectionPage from '../../components/grove/collection-page.astro';
import SearchMeta from '../../components/site/search-meta.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import {
  browseLinkFor,
  type GuideRecord,
  isEditorial,
  refreshedAt,
  splitBody,
  tileFor,
} from '../../lib/collection-guide';

export async function getStaticPaths() {
  const collections = await loadCollections(process.cwd());
  return collections.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const collections = await loadCollections(process.cwd());
const collection = collections.find((c) => c.slug === slug);
if (!collection) return Astro.redirect('/404');

const allRecords = (records as { records: unknown[] }).records;
const entries = recordsToCollectionEntries(allRecords as never, siteConfig);
const model = getCollectionPageModel(collection, entries, collections, siteConfig);
const body = splitBody(getCollectionBodyHtml(collection.content));
const recordsBySlug = new Map(
  (allRecords as GuideRecord[]).map((record) => [record.slug, record] as const),
);
const editorial = isEditorial(model.entries);
const routeSlug = siteConfig.blueprintConfig?.routeSlug ?? 'apps';
// Ranking presets that sort on activity get a one-line reminder of what
// that means; the full formula stays in the selection note.
const activityRanked =
  collection.ranking?.preset === 'active' || collection.ranking?.preset === 'recency';
// `seo.robots` is set only when the index policy excludes the page (no
// introduction): out of search engines, still in quick-find.
const searchable = !model.seo.noindex || Boolean(model.seo.robots);
const countNoun = {
  singular: siteConfig.blueprintConfig?.labelSingular ?? 'item',
  plural: siteConfig.blueprintConfig?.labelPlural ?? 'items',
};
const relatedTiles = model.related
  .map((r) => collections.find((c) => `/collections/${c.slug}/` === r.url || c.slug === r.slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((c) => tileFor(c, entries, {
    records: recordsBySlug,
    subjects: (siteConfig.taxonomy?.subjects ?? []) as Array<{ id: string; name: string }>,
    countNoun,
  }).tile);
const subject = siteConfig.taxonomy?.subjects?.find((term) => term.id === collection.subject)?.name;
---
<BaseLayout
  title={model.seo.title}
  description={model.seo.description}
  image={model.seo.image}
  imageAlt={model.seo.imageAlt}
  jsonLd={model.seo.jsonLd}
  noindex={model.seo.noindex}
  robots={model.seo.robots}
  site={siteConfig}
>
  <div data-pagefind-body={searchable ? "" : undefined}>
    {searchable && (
      <SearchMeta
        type="Collection"
        meta={{
          summary: model.collection.description,
          aliases: subject ? `${subject} alternatives, ${subject} alternative` : undefined,
        }}
      />
    )}
    <CollectionPage
      model={model}
      leadHtml={body.lead}
      comparisonAnchor={body.tableAnchor}
      bodyHtml={body.rest}
      editorial={editorial}
      eyebrow={editorial ? "Editor's picks" : "Live view"}
      records={recordsBySlug}
      browse={editorial ? undefined : browseLinkFor(collection, routeSlug)}
      refreshedAt={editorial ? undefined : refreshedAt(model.entries, recordsBySlug)}
      activityNote={activityRanked
        ? "Ranked by repository activity — recent releases, pushes and commits — not by star growth."
        : undefined}
      countNoun={countNoun}
      relatedTiles={relatedTiles}
    />
  </div>
</BaseLayout>
