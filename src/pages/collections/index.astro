---
import records from '@grove/generated/records.json';
import siteConfig from '@grove/generated/site-config.json';
import {
  getCollectionBodyHtml,
  getCollectionIndexModel,
  loadCollections,
} from '@grove-dev/astro/server';
import { runCollection } from '@grove-dev/core';
import CollectionGuide, { type GuideTile } from '../../components/site/collection-guide.astro';
import BaseLayout from '../../layouts/base-layout.astro';
import { collectionEntries } from '../../lib/collection-entries';
import {
  type GuideRecord,
  INTENT_GROUPS,
  intentOf,
  tileFor,
} from '../../lib/collection-guide';

const collections = await loadCollections(process.cwd());
const allRecords = (records as { records: unknown[] }).records;
const entries = collectionEntries(allRecords, siteConfig);
const model = getCollectionIndexModel(collections, entries, siteConfig);
const countNoun = {
  singular: siteConfig.blueprintConfig?.labelSingular ?? 'item',
  plural: siteConfig.blueprintConfig?.labelPlural ?? 'items',
};
const recordsBySlug = new Map(
  (allRecords as GuideRecord[]).map((record) => [record.slug, record] as const),
);
const subjects = (siteConfig.taxonomy?.subjects ?? []) as Array<{ id: string; name: string }>;

const now = Date.now();
const tiles = collections.map((collection) => {
  const { result, freshness, tile } = tileFor(collection, entries, {
    records: recordsBySlug,
    subjects,
    countNoun,
    now,
  });
  return {
    tile: {
      ...tile,
      hasComparison: Boolean(getCollectionBodyHtml(collection.content)?.includes('<table')),
    } satisfies GuideTile,
    intent: intentOf(collection),
    empty: result.isEmpty,
    stale: freshness.stale,
    reviewedAt: Date.parse(collection.editorial?.lastReviewedAt ?? '') || 0,
  };
});

// Feature the most recently reviewed editor's-picks collection; never an
// empty or stale one. With none eligible, nothing is featured.
const featuredCandidate = tiles
  .filter((t) => t.tile.editorial && !t.empty && !t.stale)
  .sort((a, b) => b.reviewedAt - a.reviewedAt)[0];
const featured = featuredCandidate?.tile;

const groups = INTENT_GROUPS.map((group) => ({
  ...group,
  tiles: tiles
    .filter((t) => t.intent === group.id && t.tile.slug !== featured?.slug)
    .map((t) => t.tile),
})).filter((group) => group.tiles.length > 0);

const appsCovered = new Set(
  collections.flatMap((collection) => runCollection(collection, entries).entries.map((e) => e.slug)),
).size;

const seo = model.seo;
---
<BaseLayout
  title={seo?.title ?? "Collections"}
  description={seo?.description ?? "Curated and generated directories of related items."}
  image={seo?.image}
  jsonLd={seo?.jsonLd}
  site={siteConfig}
>
  <CollectionGuide featured={featured} groups={groups} totals={{ collections: collections.length, apps: appsCovered }} />
</BaseLayout>
